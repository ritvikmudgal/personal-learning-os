# ========================================
# Personal Learning OS — Configuration
# ========================================
# Copy this file to .env and customize.
# NEVER commit .env to version control.

# --- LLM Provider ---
# Which LLM provider to use as primary: "ollama" or "cloud"
LLM_PROVIDER=ollama

# --- Ollama (Local LLM) ---
OLLAMA_BASE_URL=http://localhost:11434
OLLAMA_MODEL=qwen2.5:3b
OLLAMA_TIMEOUT=120

# --- Cloud LLM (Dormant — configure when needed) ---
# CLOUD_LLM_PROVIDER=           # openai | anthropic | google
# CLOUD_LLM_API_KEY=            # Your API key (NEVER commit this)
# CLOUD_LLM_MODEL=              # e.g., gpt-4, claude-3, gemini-pro
# CLOUD_LLM_BASE_URL=           # Optional: custom API endpoint

# --- Backend Server ---
BACKEND_HOST=127.0.0.1
BACKEND_PORT=8000

# --- Database ---
# Default: SQLite file in backend/data/
# DATABASE_URL=sqlite+aiosqlite:///./data/learning_os.db

# --- Logging ---
LOG_LEVEL=INFO

# --- Application ---
DEBUG=false
